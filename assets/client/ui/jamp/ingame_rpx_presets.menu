		itemDef
		{
			name                rpx_name
			type                ITEM_TYPE_EDITFIELD
			style               0
			text                ""
			cvar                "ui_rpx_pr_name"
			maxchars            63
			maxPaintChars       26
			rect                432 84 180 18
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          -2
			font                2
