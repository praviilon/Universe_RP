			rect                432 178 180 26
			text                "Delete"
			textalign           ITEM_ALIGN_CENTER
			textalignx          90
			textaligny          2
			font                2
			textscale           0.8
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Deletes the preset of that name from the server. Press twice"
			mouseEnter
