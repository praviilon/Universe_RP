//----------------------------------------------------------------------------------------------
// ingame_rpx_shaders: the Shader Remaps menu of the Extras.
// GLX_U: [Shader Remaps Menu] made by a generator, like the other ingame_rpx_*.menu; the Shaders button of the
// Extras tab of ingame_galaxyrp.menu opens it. The lists, the thumbnails, the preview and the rpxSh scripts are
// ui_rpshaders.c; the commands the buttons send are built in cg_rpextras.c. Preview closes it for the strip
// ingame_rpx_shprev.menu, which opens it again.
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "ingame_rpx_shaders"
		visible             0
		fullscreen          0
		outOfBoundsClick
		rect                10 20 620 440
		focusColor          1 1 1 1
		disableColor        .5 .5 .5 1
		style               1
		border              1
		descX               310
		descY               424
		descScale           0.8
		descColor           1 .682 0 .8
		descAlignment       ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		rpxShOpen
		}
		onESC
		{
			play			"sound/interface/button1.wav" ;
			close			ingame_rpx_shaders
		}

		itemDef
		{
			name                rpx_background
			style               WINDOW_STYLE_SHADER
			rect                0 0 620 440
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_title
			style               WINDOW_STYLE_SHADER
			background          "gfx/menus/menu_blendbox"
			text                "^9Universe ^7RP^3 Extras: ^7Shader Remaps"
			rect                20 5 580 28
			textalign           ITEM_ALIGN_CENTER
			textalignx          290
			textaligny          2
			font                3
			textscale           0.9
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_back
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 405 90 24
			text                "Back"
			textalign           ITEM_ALIGN_CENTER
			textalignx          45
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Back to the Universe RP menu"
			mouseEnter
			{
				setitemcolor rpx_back bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_back bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				setcvar ui_rpx_back 1 ;
				close ingame_rpx_shaders ;
				open ingame_galaxyrp
			}
		}
		itemDef
		{
			name                rpx_msg
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                110 415 500 14
			cvar                "ui_rpx_msg"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.6
			forecolor           1 1 .4 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_tab_map
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 38 142 20
			text                "Map shaders"
			textalign           ITEM_ALIGN_CENTER
			textalignx          71
			textaligny          0
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "The shaders this map's surfaces use"
			mouseEnter
			{
				setitemcolor rpx_tab_map bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_tab_map bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpxShView 0
			}
		}
		itemDef
		{
			name                rpx_tab_remaps
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                158 38 142 20
			text                "Current remaps"
			textalign           ITEM_ALIGN_CENTER
			textalignx          71
			textaligny          0
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "The remaps in force: select one to remove it"
			mouseEnter
			{
				setitemcolor rpx_tab_remaps bordercolor 1 1 1 1
