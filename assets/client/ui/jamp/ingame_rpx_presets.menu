			decoration
			cvarTest            "ui_rpx_presetmode"
			showCvar
			{
				"1"
			}
		}
		itemDef
		{
			name                rpx_filter
			type                ITEM_TYPE_EDITFIELD
			style               0
			text                "Filter: "
			cvar                "ui_rpx_filter_entpresets"
			maxchars            30
			maxPaintChars       30
			rect                12 64 400 18
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          -2
			font                2
			textscale           0.6
			forecolor           1 1 1 1
			outlinecolor        1 .5 .5 .5
			backcolor           0 0 0 .6
			border              1
			bordercolor         .5 .5 .5 .6
			visible             1
			descText            "Show only the names with this in them"
		}
		itemDef
		{
			name                rpx_list
			type                ITEM_TYPE_LISTBOX
			style               WINDOW_STYLE_FILLED
			rect                12 84 400 270
			elementwidth        380
			elementheight       15
			elementtype         LISTBOX_TEXT
			feeder              FEEDER_RPX_LIST
			font                2
			textscale           0.55
			textstyle           0
			textalign           0
			textaligny          0
			columns             1 4 374 374
			border              1
			bordercolor         1 .682 0 .6
			forecolor           1 1 1 1
			backcolor           0 0 0 .6
			outlinecolor        1 .682 0 .35
			visible             1
			descText            "Select a preset to load, overwrite or delete"
			mouseEnter
			{
				setitemcolor rpx_list bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_list bordercolor 1 .682 0 .6
			}
		}
		itemDef
		{
			name                rpx_info
