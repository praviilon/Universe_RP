//----------------------------------------------------------------------------------------------
// ingame_rpx_emotes: the Emotes menu of the Extras.
// GLX_U: [Emotes Menu] made by a generator, like the other ingame_rpx_*.menu; the Emotes button of the Extras tab
// of ingame_galaxyrp.menu opens it. /emote, /anim, /wehug and /wekiss, with a preview of the player's own
// character: the lists, the preview and the rpxEm scripts are ui_rpemotes.c; the commands the buttons send are
// built in cg_rpextras.c from the names the server takes too (game/bg_rpemotes.h).
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "ingame_rpx_emotes"
		visible             0
		fullscreen          0
		outOfBoundsClick
		rect                10 20 620 440
		focusColor          1 1 1 1
		disableColor        .5 .5 .5 1
		style               1
		border              1
		descX               310
		descY               424
		descScale           0.8
		descColor           1 .682 0 .8
		descAlignment       ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		rpxEmOpen
		}
		onClose
		{
			uiScript		rpxEmClose
		}
		onESC
		{
			play			"sound/interface/button1.wav" ;
			close			ingame_rpx_emotes
		}

		itemDef
		{
			name                rpx_background
			style               WINDOW_STYLE_SHADER
			rect                0 0 620 440
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_title
			style               WINDOW_STYLE_SHADER
			background          "gfx/menus/menu_blendbox"
			text                "^9Universe ^7RP^3 Extras: ^7Emotes"
			rect                20 5 580 28
			textalign           ITEM_ALIGN_CENTER
			textalignx          290
			textaligny          2
			font                3
			textscale           0.9
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_back
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 405 90 24
			text                "Back"
			textalign           ITEM_ALIGN_CENTER
			textalignx          45
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Back to the Universe RP menu"
			mouseEnter
			{
				setitemcolor rpx_back bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_back bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				setcvar ui_rpx_back 1 ;
				close ingame_rpx_emotes ;
				open ingame_galaxyrp
			}
		}
		itemDef
		{
			name                rpx_msg
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                110 415 500 14
