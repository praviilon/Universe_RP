//----------------------------------------------------------------------------------------------
// ingame_rpx_presets: the Presets menu of the Extras.
// GLX_U: [Presets Menu] made by a generator, like the other ingame_rpx_*.menu; the Presets button of the Extras
// tab of ingame_galaxyrp.menu opens it. This map's entity and remap presets, in one list with two tabs (the
// server lists them: /rpxlist entpresets and remappresets, g_rplist.c), to load, save and delete: the list, the
// tabs and the rpxPreset scripts are ui_rpextras.c; the commands the buttons send are built in cg_rpextras.c.
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "ingame_rpx_presets"
		visible             0
		fullscreen          0
		outOfBoundsClick
		rect                10 20 620 440
		focusColor          1 1 1 1
		disableColor        .5 .5 .5 1
		style               1
		border              1
		descX               310
		descY               424
		descScale           0.8
		descColor           1 .682 0 .8
		descAlignment       ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		rpxOpen presets ingame_rpx_presets
		}
		onClose
		{
			uiScript		rpxClose
		}
		onESC
		{
			play			"sound/interface/button1.wav" ;
			close			ingame_rpx_presets
		}

		itemDef
		{
			name                rpx_background
			style               WINDOW_STYLE_SHADER
			rect                0 0 620 440
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_title
			style               WINDOW_STYLE_SHADER
			background          "gfx/menus/menu_blendbox"
			text                "^9Universe ^7RP^3 Extras: ^7Presets"
			rect                20 5 580 28
			textalign           ITEM_ALIGN_CENTER
			textalignx          290
			textaligny          2
			font                3
			textscale           0.9
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_back
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 405 90 24
			text                "Back"
			textalign           ITEM_ALIGN_CENTER
			textalignx          45
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Back to the Universe RP menu"
			mouseEnter
			{
				setitemcolor rpx_back bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_back bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				setcvar ui_rpx_back 1 ;
				close ingame_rpx_presets ;
				open ingame_galaxyrp
			}
		}
		itemDef
		{
			name                rpx_msg
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                110 415 500 14
			cvar                "ui_rpx_msg"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.6
			forecolor           1 1 .4 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_tab_ent
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 40 103 20
			text                "Entities"
			textalign           ITEM_ALIGN_CENTER
			textalignx          51
			textaligny          0
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "The entity presets saved for this map"
			mouseEnter
			{
				setitemcolor rpx_tab_ent bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_tab_ent bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpxPresetMode 0
			}
		}
		itemDef
		{
			name                rpx_tab_remap
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                119 40 103 20
			text                "Remaps"
			textalign           ITEM_ALIGN_CENTER
			textalignx          51
			textaligny          0
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "The shader remap presets saved for this map"
			mouseEnter
			{
				setitemcolor rpx_tab_remap bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_tab_remap bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpxPresetMode 1
			}
		}
		itemDef
		{
			name                rpx_tab_ent_on
			style               WINDOW_STYLE_FILLED
			rect                14 58 99 2
			backcolor           1 1 1 1
			visible             1
			decoration
			cvarTest            "ui_rpx_presetmode"
			showCvar
			{
				"0"
			}
		}
		itemDef
		{
			name                rpx_tab_remap_on
			style               WINDOW_STYLE_FILLED
			rect                121 58 99 2
			backcolor           1 1 1 1
