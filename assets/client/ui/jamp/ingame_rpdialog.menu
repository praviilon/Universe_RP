//----------------------------------------------------------------------------------------------
// ingame_rpdialog: a target_dialog's dialogue (GLX_U: [Dialogues]). Opened by the cgame on the server's
// rpdlg (cg_rpdialog.c), drawn from the ui_rpdlg_* cvars it set: the title, up to seven lines of text the
// cgame broke at 572 px / textscale 0.58 with the ergoec widths, up to six options. A click or the keys
// 1-6 run rpDialogChoose <n> (ui_rpdialog.c); Esc closes it, and onClose sends the walk-away. The panel is
// the Extras' look. The textscale and the 572-wide column are what cg_rpdialog.c measures against: change
// one, change the other.
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                    "ingame_rpdialog"
		visible                 0
		fullscreen              0
		rect                    20 100 600 280
		focusColor              1 1 1 1
		disableColor            .5 .5 .5 1
		style                   1
		border                  1

		onClose
		{
			uiScript		rpDialogClosed
		}
		onESC
		{
			uiScript		rpDialogClosed ;
			close			ingame_rpdialog
		}

		itemDef
		{
			name                rpdlg_box
			style               WINDOW_STYLE_SHADER
			rect                0 0 600 280
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_title
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 8 572 18
			cvar                "ui_rpdlg_title"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.7
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_textbox
			style               WINDOW_STYLE_FILLED
			rect                10 30 580 122
			backcolor           0 0 0 .35
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line1
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 34 572 16
			cvar                "ui_rpdlg_line1"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
