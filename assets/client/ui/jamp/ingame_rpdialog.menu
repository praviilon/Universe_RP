		itemDef
		{
			name                rpdlg_opt1
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                14 158 572 17
			cvar                "ui_rpdlg_opt1"
			textalign           ITEM_ALIGN_LEFT
			textalignx          4
			textaligny          1
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			backcolor           0 0 0 0
			visible             1
			mouseEnter
			{
				setitemcolor rpdlg_opt1 backcolor 1 .682 0 .25
			}
			mouseExit
			{
				setitemcolor rpdlg_opt1 backcolor 0 0 0 0
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpDialogChoose 1 ;
				close ingame_rpdialog
			}
		}
		itemDef
		{
			name                rpdlg_opt2
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                14 175 572 17
			cvar                "ui_rpdlg_opt2"
			textalign           ITEM_ALIGN_LEFT
			textalignx          4
			textaligny          1
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			backcolor           0 0 0 0
			visible             1
			cvarTest            "ui_rpdlg_count"
			showCvar            { "2" "3" "4" "5" "6" }
			mouseEnter
			{
				setitemcolor rpdlg_opt2 backcolor 1 .682 0 .25
			}
			mouseExit
			{
