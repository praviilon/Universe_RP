//----------------------------------------------------------------------------------------------
// ingame_rpx_shprev: the Shader Remaps menu's preview strip.
// GLX_U: [Shader Remaps Menu] open while a remap is previewed on this game only (rpxShPreview, ui_rpshaders.c), in
// the place of ingame_rpx_shaders.menu, so the surfaces can be seen. Closing it, by any way, takes the preview
// back (rpxShPreviewEnd); its buttons and Esc open the menu again.
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "ingame_rpx_shprev"
		visible             0
		fullscreen          0
		outOfBoundsClick
		rect                10 404 620 66
		focusColor          1 1 1 1
		disableColor        .5 .5 .5 1
		style               1
		border              1

		onClose
		{
			uiScript		rpxShPreviewEnd
		}
		onESC
		{
			play			"sound/interface/button1.wav" ;
			close			ingame_rpx_shprev ;
			open			ingame_rpx_shaders
		}

		itemDef
		{
			name                rpx_background
			style               WINDOW_STYLE_SHADER
			rect                0 0 620 66
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_prevtext
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 8 592 14
			cvar                "ui_rpx_sh_prevtext"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.55
			forecolor           1 .682 0 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_prevapply
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                150 32 100 24
			text                "Apply"
			textalign           ITEM_ALIGN_CENTER
			textalignx          50
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			mouseEnter
			{
				setitemcolor rpx_prevapply bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_prevapply bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpxShApply ;
				close ingame_rpx_shprev ;
				open ingame_rpx_shaders
			}
		}
		itemDef
		{
			name                rpx_prevpick
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                260 32 130 24
			text                "Pick from world"
			textalign           ITEM_ALIGN_CENTER
			textalignx          65
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			mouseEnter
			{
				setitemcolor rpx_prevpick bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_prevpick bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpxShPick ;
				close ingame_rpx_shprev ;
				open ingame_rpx_shaders
			}
		}
		itemDef
		{
			name                rpx_prevback
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                400 32 100 24
			text                "Back"
			textalign           ITEM_ALIGN_CENTER
			textalignx          50
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			mouseEnter
			{
				setitemcolor rpx_prevback bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_prevback bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				close ingame_rpx_shprev ;
				open ingame_rpx_shaders
			}
		}
	}
}
