			cvarTest            "ui_rpx_g_tab"
			showCvar
			{
				"1"
			}
		}
		itemDef
		{
			name                rpx_animreplay
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                432 326 180 18
			text                "Replay"
			textalign           ITEM_ALIGN_CENTER
			textalignx          90
			textaligny          1
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
