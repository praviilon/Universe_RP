		itemDef
		{
			name                rpx_list
			type                ITEM_TYPE_LISTBOX
			style               WINDOW_STYLE_FILLED
			rect                12 82 288 180
			elementwidth        268
			elementheight       15
			elementtype         LISTBOX_TEXT
			feeder              FEEDER_RPX_SHMAP
			font                2
			textscale           0.55
			textstyle           0
			textalign           0
			textaligny          0
			columns             1 4 262 262
			border              1
			bordercolor         1 .682 0 .6
			forecolor           1 1 1 1
			backcolor           0 0 0 .6
			outlinecolor        1 .682 0 .35
