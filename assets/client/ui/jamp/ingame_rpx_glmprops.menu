//----------------------------------------------------------------------------------------------
// ingame_rpx_glmprops: the GLM Props menu of the Extras.
// GLX_U: [Extras] MD3 Props (ingame_rpx_props.menu) for .glm models, spawned as a misc_model_ghoul:
// the same layout, with its own ui_rpx_g_* cvars. No Animated, Breakable or Health (a misc_model_ghoul
// takes no damage). Its right-hand column has two tabs (ui_rpx_g_tab): Prop, and Animation -- the frames
// of the model's animation file it plays, typed or taken from its named animations. The GLM Props button
// of ingame_galaxyrp.menu opens it. The list, the preview and the rpx scripts are ui_rpextras.c; the
// commands the buttons send are built in cg_rpextras.c.
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                    "ingame_rpx_glmprops"
		visible                 0
		fullscreen              0
		outOfBoundsClick
		rect                    10 20 620 440
		focusColor              1 1 1 1
		disableColor            .5 .5 .5 1
		style                   1
		border                  1
		descX                   310
		descY                   424
		descScale               0.8
		descColor               1 .682 0 .8
		descAlignment           ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		rpxOpen glmprops ingame_rpx_glmprops
		}
		onClose
		{
			uiScript		rpxClose
		}
		onESC
		{
			play			"sound/interface/button1.wav" ;
			close			ingame_rpx_glmprops
		}

		itemDef
		{
			name                rpx_background
			style               WINDOW_STYLE_SHADER
			rect                0 0 620 440
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_title
			style               WINDOW_STYLE_SHADER
			background          "gfx/menus/menu_blendbox"
			text                "^9Universe ^7RP^3 Extras: ^7GLM Props"
			rect                20 5 580 28
			textalign           ITEM_ALIGN_CENTER
			textalignx          290
			textaligny          2
			font                3
			textscale           0.9
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpx_back
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                12 405 90 24
			text                "Back"
			textalign           ITEM_ALIGN_CENTER
			textalignx          45
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Back to the Universe RP menu"
			mouseEnter
			{
				setitemcolor rpx_back bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_back bordercolor 1 .682 0 .6
			}
			action
			{
				play "sound/interface/button1.wav" ;
				setcvar ui_rpx_back 1 ;
				close ingame_rpx_glmprops ;
				open ingame_galaxyrp
			}
		}
